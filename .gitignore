# Patterns that start with "/" match at the top of the repository only, so they
# can never hide a package, test or documentation directory of the same name.

# -----------------------------------------------------------------------------
# Secrets and private material - never commit any of these
# -----------------------------------------------------------------------------

# Keys, and environment files that may hold WDVA_KEY or WDVA_PASSPHRASE
*.key
*_key.txt
.env
.env.*
!.env.example

# Vaults: encrypted, but still somebody's private adapter
*.wdva

# Plaintext adapters: a local output directory and PEFT weight files
/adapters/
adapter_model.safetensors
adapter_model.bin

# -----------------------------------------------------------------------------
# Model caches
# -----------------------------------------------------------------------------
.cache/
/models/

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/

# Build output
/build/
/dist/

# Virtual environments
/.venv/
/venv/
/env/
/ENV/

# -----------------------------------------------------------------------------
# Tests, coverage and tool caches
# -----------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/

# -----------------------------------------------------------------------------
# Editors, notebooks and operating systems
# -----------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.ipynb_checkpoints/
*.log
.DS_Store
Thumbs.db
